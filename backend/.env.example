# Either LLM_API_KEY or OPENAI_API_KEY enables the model. DISCO_FORCE_HEURISTIC=1 disables it.
LLM_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional. Publisher vectors are cached on disk after the first embed (survives --reload).
# DISCO_EMBED_CACHE=
# Optional. Tracing needs both LANGSMITH_TRACING=true and a key. Leave off otherwise.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=disco-campaign-builder
